# ─── DanceDesk — Variables d'environnement Staging ───────────────────────────
# Copier ce fichier, remplir les valeurs, et configurer dans Vercel Dashboard
# sous l'environnement "Preview".
#
# Sur Vercel, NODE_ENV vaut toujours "production". L'app détecte le staging via
# VERCEL_ENV=preview (injecté automatiquement par Vercel — ne pas surcharger).

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dancedesk_staging

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://staging.dancedesk.ch

# ─── Email — Resend ───────────────────────────────────────────────────────────
# Même domaine que la prod (dancedesk.ch, déjà vérifié sur Resend).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

EMAIL_FROM_NOREPLY=noreply@dancedesk.ch
EMAIL_FROM_HELLO=hello@dancedesk.ch
EMAIL_FROM_SECURITY=security@dancedesk.ch
EMAIL_FROM_NOTIFICATIONS=notifications@dancedesk.ch

# ─── Email — redirection staging ──────────────────────────────────────────────
# ⚠️  OBLIGATOIRE en staging. Tous les emails sont redirigés vers cette adresse.
# Empêche l'envoi accidentel d'emails à de vrais utilisateurs.
EMAIL_OVERRIDE_TO=diego.dancelab@gmail.com
