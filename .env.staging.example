# ─── DanceDesk — Variables d'environnement Staging ───────────────────────────
# Copier ce fichier, remplir les valeurs, et configurer dans Vercel Dashboard
# sous l'environnement "Preview".
#
# Sur Vercel, NODE_ENV vaut toujours "production". L'app détecte le staging via
# VERCEL_ENV=preview (injecté automatiquement par Vercel — ne pas surcharger).

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dancedesk_staging

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://staging.dancedesk.ch

# ─── Email — Resend ───────────────────────────────────────────────────────────
# Clé Resend dédiée au staging. Obtenir sur resend.com/api-keys.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ─── Email — adresses expéditeurs (domaine staging vérifié sur Resend) ────────
EMAIL_FROM_NOREPLY=noreply@staging.dancedesk.ch
EMAIL_FROM_HELLO=hello@staging.dancedesk.ch
EMAIL_FROM_SECURITY=security@staging.dancedesk.ch
EMAIL_FROM_NOTIFICATIONS=notifications@staging.dancedesk.ch

# ─── Email — sécurité ─────────────────────────────────────────────────────────
# ⚠️  OBLIGATOIRE en staging. Tous les emails sont redirigés vers cette adresse.
# Empêche l'envoi accidentel d'emails à de vrais utilisateurs depuis le staging.
EMAIL_OVERRIDE_TO=staging-tests@dancedesk.ch
