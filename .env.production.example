# ─── DanceDesk — Variables d'environnement Production ────────────────────────
# Copier ce fichier, remplir les valeurs, et configurer dans Vercel Dashboard
# sous l'environnement "Production".
#
# Sur Vercel, VERCEL_ENV=production est injecté automatiquement.
# En production, les emails sont envoyés aux vrais destinataires via Resend.
# EMAIL_OVERRIDE_TO ne doit PAS être configuré en production.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/dancedesk_prod

# ─── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://dancedesk.ch

# ─── Email — Resend ───────────────────────────────────────────────────────────
# Clé Resend production. Obtenir sur resend.com/api-keys.
# ⚠️  Ne jamais committer cette valeur — configurer uniquement dans Vercel.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ─── Email — adresses expéditeurs (domaines vérifiés sur Resend) ──────────────
EMAIL_FROM_NOREPLY=noreply@dancedesk.ch
EMAIL_FROM_HELLO=hello@dancedesk.ch
EMAIL_FROM_SECURITY=security@dancedesk.ch
EMAIL_FROM_NOTIFICATIONS=notifications@dancedesk.ch
