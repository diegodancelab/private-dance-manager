# ─── Database ────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string. Used by the app and Prisma CLI.
# - Local dev : pointe vers le container Docker Compose (voir ci-dessous)
# - Vercel    : configurer par environnement dans le dashboard Vercel
DATABASE_URL=postgresql://postgres:password@localhost:5432/private_dance_manager

# ─── App URL ─────────────────────────────────────────────────────────────────
# URL publique de l'app. Utilisée pour construire les liens dans les emails.
# - Local dev : http://localhost:3000
# - Prod      : https://dancedesk.ch (à définir dans Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Email — dev local (Mailpit) ─────────────────────────────────────────────
# En développement, tous les emails sont interceptés par Mailpit.
# Aucun email ne quitte la machine. Aucune clé Resend requise.
# Démarrer : docker compose up -d mailpit
# Interface : http://localhost:8025
MAILPIT_HOST=localhost
MAILPIT_SMTP_PORT=1025

# ─── Email — adresses expéditeurs ────────────────────────────────────────────
# Même structure sur les trois environnements.
# En dev → Mailpit intercepts (domaine fictif OK).
# En staging/prod → domaines vérifiés sur Resend requis.
EMAIL_FROM_NOREPLY=noreply@dancedesk.ch
EMAIL_FROM_HELLO=hello@dancedesk.ch
EMAIL_FROM_SECURITY=security@dancedesk.ch
EMAIL_FROM_NOTIFICATIONS=notifications@dancedesk.ch

# ─── Email — Resend (staging + production uniquement) ────────────────────────
# Non requis en dev (Mailpit). Obtenir sur resend.com/api-keys.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ─── Email — redirection (optionnel) ─────────────────────────────────────────
# Si défini, TOUS les emails (staging et prod) sont redirigés vers cette adresse.
# À définir en staging pour éviter d'envoyer à de vrais utilisateurs.
# Ne pas définir en production.
# EMAIL_OVERRIDE_TO=your-email@gmail.com

# ─── Bootstrap (à exécuter une seule fois pour créer le premier compte prof) ─
# Utilisé par : npm run bootstrap:prod
# À lancer en local en pointant DATABASE_URL vers la base de prod.
# Ne jamais configurer ces variables sur Vercel.
# BOOTSTRAP_EMAIL=you@example.com
# BOOTSTRAP_PASSWORD=<strong-password-min-12-chars>
# BOOTSTRAP_FIRST_NAME=Prénom
# BOOTSTRAP_LAST_NAME=Nom
# BOOTSTRAP_PHONE=+41000000000

# ─── Docker Compose (développement local uniquement) ─────────────────────────
# Configure le container PostgreSQL local. Doit correspondre à DATABASE_URL.
# Non utilisé par Vercel.
POSTGRES_DB=private_dance_manager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432
